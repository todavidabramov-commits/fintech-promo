# Local Docker: docker compose up -d postgres
# DATABASE_URL=postgresql://payload:payload@localhost:5432/fintech_promo
#
# Neon / Vercel: use pooled connection string with sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
PAYLOAD_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
